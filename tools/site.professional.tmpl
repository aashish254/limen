<script>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* count-up on the stat strip. The finished number is already in the markup, so this
     only ever adds motion — a page that never runs it still reads correctly. */
  function countUp(el){
    var raw = el.getAttribute('data-count');
    var target = parseFloat(raw);
    var dec = (raw.split('.')[1]||'').length;
    if (reduce || !isFinite(target)) { el.textContent = raw; return; }
    var t0 = null, dur = 1100;
    function step(ts){
      if(!t0) t0 = ts;
      var p = Math.min((ts-t0)/dur,1);
      var eased = 1 - Math.pow(1-p,3);
      el.textContent = (target*eased).toFixed(dec);
      if(p<1) requestAnimationFrame(step);
      else el.textContent = raw;
    }
    requestAnimationFrame(step);
  }
  var nums = document.querySelectorAll('[data-count]');
  if (!('IntersectionObserver' in window)) {
    for (var k=0;k<nums.length;k++) countUp(nums[k]);
  } else {
    var io2 = new IntersectionObserver(function(es){
      es.forEach(function(e){ if(e.isIntersecting){ countUp(e.target); io2.unobserve(e.target);} });
    },{threshold:.5});
    for (var m=0;m<nums.length;m++) io2.observe(nums[m]);
  }

  /* scroll progress */
  var bar = document.getElementById('progress');
  function tick(){
    var h = document.documentElement;
    var max = h.scrollHeight - h.clientHeight;
    bar.style.width = (max>0 ? Math.min(h.scrollTop/max*100,100) : 0) + '%';
  }
  document.addEventListener('scroll', tick, {passive:true}); tick();

  /* copy buttons — one handler, reads the element it is told to read */
  function flash(btn, text){
    var old = btn.textContent;
    btn.textContent = text; btn.classList.add('done');
    setTimeout(function(){ btn.textContent = old; btn.classList.remove('done'); }, 1600);
  }
  /* mark any frame that still has content off its right edge */
  var scrollers = document.querySelectorAll('.scroller');
  function markScrollers(){
    for (var q=0;q<scrollers.length;q++){
      var el = scrollers[q];
      if (el.scrollWidth - el.scrollLeft - el.clientWidth > 2) el.setAttribute('data-more','1');
      else el.removeAttribute('data-more');
    }
  }
  for (var r=0;r<scrollers.length;r++) scrollers[r].addEventListener('scroll', markScrollers, {passive:true});
  window.addEventListener('resize', markScrollers);
  markScrollers();

  document.addEventListener('click', function(ev){
    var btn = ev.target.closest ? ev.target.closest('[data-copy]') : null;
    if (!btn) return;
    var src = document.getElementById(btn.getAttribute('data-copy'));
    var text = src ? src.textContent.trim() : '';
    if (!text) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function(){ flash(btn,'copied'); },
        function(){ flash(btn,'select it'); });
    } else { flash(btn,'select it'); }
  });
})();
</script>
