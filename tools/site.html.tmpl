<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Limen — where decisions happen before costs do</title>
<meta name="description" content="Local decision layer for coding agents. {{HEAD_PCT}}% fewer tokens on measured traffic, pass-rate held, zero API spend.">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0B1121">
<link rel="canonical" href="https://aashish254.github.io/limen/">
<meta property="og:title" content="Limen — where decisions happen before costs do">
<meta property="og:description" content="Local decision layer for coding agents. Measured token reduction, pass-rate held, runs locally at zero cost.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ─────────────── RESET & BASICS ─────────────── */
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;background:#0B1121}
body{
  margin:0;font-family:'Inter',system-ui,-apple-system,sans-serif;
  font-size:16px;line-height:1.7;color:#E2E8F0;
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
}
h1,h2,h3,h4{font-weight:700;margin:0}
p{margin-bottom:1rem}
code,kbd{font-family:'JetBrains Mono',monospace}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
ul{margin:0;padding:0;list-style:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 clamp(24px,4vw,64px)}
svg{display:block}

/* ─────────────── VARIABLES ─────────────── */
:root{
  --bg-deep:#0B1121;
  --bg-card:#121A2D;
  --bg-elevated:#1A2438;
  --border:#1E293B;
  --border-glow:#3B82F633;
  --text-primary:#F1F5F9;
  --text-secondary:#94A3B8;
  --text-muted:#64748B;
  --accent-primary:#3B82F6;
  --accent-glow:#3B82F680;
  --accent-light:#60A5FA;
  --success:#10B981;
  --warning:#F59E0B;
  --danger:#EF4444;
  --gradient-hero:linear-gradient(135deg,#3B82F6,#8B5CF6);
  --gradient-glow:radial-gradient(circle,rgba(59,130,246,.15) 0%,transparent 70%);
}

/* ─────────────── NAVIGATION ─────────────── */
nav.navbar{
  position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(11,17,33,.85);backdrop-filter:blur(16px)saturate(1.2);
  border-bottom:1px solid var(--border);
}
.nav-inner{
  display:flex;align-items:center;justify-content:space-between;
  height:72px;
}
.brand{
  display:flex;align-items:center;gap:12px;font-weight:800;font-size:20px;
  color:var(--text-primary);
}
.brand svg{width:32px;height:32px}
.brand span{letter-spacing:-.02em}
.nav-links{display:flex;gap:32px;font-size:14px;font-weight:500}
.nav-links a{
  color:var(--text-secondary);transition:color .2s;
  padding:6px 0;border-bottom:2px solid transparent;
}
.nav-links a:hover{color:var(--text-primary)}

/* ─────────────── HERO ─────────────── */
.hero{
  padding:clamp(120px,15vw,160px) 0 clamp(80px,12vw,120px);
  background:var(--gradient-glow);position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:
    radial-gradient(ellipse at 20% 20%,rgba(59,130,246,.08),transparent 50%),
    radial-gradient(ellipse at 80% 80%,rgba(139,92,246,.06),transparent 50%);
}
.hero-grid{
  display:grid;grid-template-columns:1fr 1fr;gap:clamp(48px,8vw,96px);
  align-items:center;position:relative;z-index:1;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:500;
  color:var(--accent-primary);
  background:rgba(59,130,246,.1);border:1px solid rgba(59,130,246,.3);
  padding:6px 12px;border-radius:100px;
  margin-bottom:24px;
}
.badge-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--accent-primary);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.hero-title{
  font-size:clamp(42px,6vw,64px);font-weight:800;line-height:1.05;
  letter-spacing:-.03em;margin-bottom:20px;
}
.hero-gradient{
  background:var(--gradient-hero);-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text;
}
.hero-subtitle{
  font-size:clamp(18px,2.5vw,22px);color:var(--text-secondary);
  line-height:1.6;margin-bottom:32px;
}
.cta-buttons{display:flex;gap:16px;flex-wrap:wrap}
.btn-primary, .btn-secondary{
  display:inline-flex;align-items:center;gap:10px;
  font-weight:600;font-size:15px;padding:14px 28px;border-radius:12px;
  transition:all .2s;cursor:pointer;border:none;
}
.btn-primary{
  background:var(--accent-primary);color:white;
  box-shadow:0 10px 40px rgba(59,130,246,.3);
}
.btn-primary:hover{background:var(--accent-light);transform:translateY(-2px);box-shadow:0 14px 48px rgba(59,130,246,.4)}
.btn-secondary{
  background:transparent;color:var(--text-primary);
  border:1px solid var(--border);
}
.btn-secondary:hover{border-color:var(--accent-primary);background:rgba(59,130,246,.05)}

/* Terminal demo */
.demo-terminal{
  background:var(--bg-card);border-radius:16px;
  border:1px solid var(--border);
  overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.4);
}
.terminal-header{
  display:flex;align-items:center;gap:8px;padding:14px 18px;
  background:rgba(255,255,255,.03);border-bottom:1px solid var(--border);
}
.terminal-dots{display:flex;gap:8px}
.terminal-dot{width:12px;height:12px;border-radius:50%}
.terminal-dot.red{background:#EF4444}
.terminal.dot.yellow{background:#F59E0B}
.terminal-dot.green{background:#10B981}
.terminal-title{
  flex:1;font-family:'JetBrains Mono',monospace;font-size:13px;
  color:var(--text-muted);margin-left:8px;
}
.terminal-body{padding:20px;font-family:'JetBrains Mono',monospace;font-size:14px;line-height:1.8;color:var(--text-secondary)}
.term-comment{color:var(--text-muted)}
.term-purple{color:#C084FC;font-weight:500}
.term-blue{color:var(--accent-primary);font-weight:500}
.term-green{color:var(--success);font-weight:500}
.term-orange{color:var(--warning);font-weight:500}
.term-arrow{color:var(--accent-glow);font-weight:600}

/* ─────────────── STATS BAR ─────────────── */
.stats-bar{
  background:var(--bg-elevated);border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
}
.stats-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:32px;padding:clamp(40px,6vw,64px) 0;
}
.stat-item{
  display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;
}
.stat-label{
  font-size:13px;font-weight:500;color:var(--text-secondary);
  text-transform:uppercase;letter-spacing:.08em;
}
.stat-value{
  font-size:clamp(32px,5vw,48px);font-weight:800;
  color:var(--text-primary);line-height:1;
}
.stat-value.highlight{
  background:var(--gradient-hero);-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text;
}
.stat-unit{
  font-size:16px;color:var(--text-muted);margin-left:4px;
}

/* ─────────────── FEATURES ─────────────── */
.features{padding:clamp(80px,12vw,120px) 0}
.section-title{
  text-align:center;margin-bottom:64px;
}
.section-title h2{
  font-size:clamp(32px,4vw,48px);margin-bottom:16px;
}
.section-title p{
  font-size:18px;color:var(--text-secondary);max-width:600px;margin:0 auto;
}
.feature-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:32px;
}
.feature-card{
  background:var(--bg-card);border-radius:16px;padding:32px;
  border:1px solid var(--border);transition:all .3s;
}
.feature-card:hover{
  transform:translateY(-8px);
  border-color:var(--border-glow);
  box-shadow:0 20px 40px rgba(59,130,246,.08);
}
.feature-icon{
  width:48px;height:48px;border-radius:12px;
  background:rgba(59,130,246,.1);
  display:flex;align-items:center;justify-content:center;
  margin-bottom:20px;
}
.feature-icon svg{width:24px;height:24px;stroke:var(--accent-primary)}
.feature-card h3{
  font-size:20px;margin-bottom:12px;color:var(--text-primary);
}
.feature-card p{color:var(--text-secondary);margin:0}

/* ─────────────── HOW IT WORKS ─────────────── */
.how-it-works{
  padding:clamp(80px,12vw,120px) 0;
  background:linear-gradient(180deg,var(--bg-deep),var(--bg-card));
}
.steps{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:40px;margin-top:48px;
}
.step-number{
  font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;
  color:var(--accent-primary);margin-bottom:16px;
}
.step-number::before{content:'0';content attr(data-step);counter-increment:step;}
.step-card h3{font-size:22px;margin-bottom:12px}
.step-card p{color:var(--text-secondary);margin:0}

/* ─────────────── TERMINAL EXAMPLES ─────────────── */
.terminal-section{padding:clamp(80px,12vw,120px) 0}
.terminals-container{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));
  gap:32px;margin-top:48px;
}
.terminal-example{
  background:var(--bg-card);border-radius:16px;
  border:1px solid var(--border);overflow:hidden;
}
.code-sample{padding:24px;font-family:'JetBrains Mono',monospace;font-size:13px;line-height:1.9}
.code-line{display:block}

/* ─────────────── CTA SECTION ─────────────── */
.cta-section{
  padding:clamp(80px,12vw,120px) 0;text-align:center;
  background:linear-gradient(180deg,var(--bg-card),var(--bg-deep));
}
.cta-content{max-width:700px;margin:0 auto}
.cta-content h2{
  font-size:clamp(32px,4vw,48px);margin-bottom:20px;
}
.cta-content p{
  font-size:18px;color:var(--text-secondary);margin-bottom:32px;
}

/* ─────────────── FOOTER ─────────────── */
footer.footer{
  background:var(--bg-card);border-top:1px solid var(--border);
  padding:clamp(48px,8vw,80px) 0;
}
.footer-content{
  display:flex;justify-content:space-between;align-items:flex-start;
  gap:48px;flex-wrap:wrap;
}
.footer-brand{max-width:300px}
.footer-brand h3{font-size:20px;margin-bottom:12px}
.footer-brand p{color:var(--text-secondary);margin:0;font-size:14px}
.footer-nav{display:flex;gap:48px}
.footer-column{display:flex;flex-direction:column;gap:12px}
.footer-column h4{font-size:14px;font-weight:600;margin-bottom:8px}
.footer-column a{
  font-size:14px;color:var(--text-secondary);transition:color .2s;
}
.footer-column a:hover{color:var(--accent-primary)}
.copyright{
  margin-top:48px;padding-top:32px;border-top:1px solid var(--border);
  text-align:center;color:var(--text-muted);font-size:14px;
}

/* ─────────────── RESPONSIVE ─────────────── */
@media(max-width:900px){
  .hero-grid{grid-template-columns:1fr}
  .hero-grid{gap:48px}
  .nav-links{display:none}
  .terminals-container{grid-template-columns:1fr}
  .code-sample{font-size:11px}
}
</style>
</head>
<body>
<!-- Navigation -->
<nav class="navbar">
  <div class="nav-inner wrap">
    <a href="/" class="brand">
      <!-- Limen Logo (Threshold concept) -->
      <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
        <!-- Background circle -->
        <circle cx="32" cy="32" r="30" fill="none" stroke="#3B82F6" stroke-width="2"/>
        <!-- Threshold line -->
        <line x1="8" y1="32" x2="56" y2="32" stroke="#3B82F6" stroke-width="2"/>
        <!-- Arrow crossing threshold -->
        <polygon points="44,18 36,28 41,28 30,39 36,39 21,54 26,54 39,41 34,41 44,31 39,31" fill="#3B82F6"/>
      </svg>
      <span>Limen</span>
    </a>
    <nav class="nav-links">
      <a href="#features">Features</a>
      <a href="#how-it-works">How it works</a>
      <a href="#terminal">Terminal</a>
      <a href="https://github.com/aashish254/limen" class="gh">GitHub</a>
    </nav>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          System One for Coding Agents
        </div>
        <h1 class="hero-title">
          Where decisions happen <span class="hero-gradient">before costs do</span>
        </h1>
        <p class="hero-subtitle">
          Local decision layer that sits between your coding agent and its model API. 
          Decide what context matters before you pay.
        </p>
        <div class="cta-buttons">
          <a href="/#install" class="btn-primary">Install Now</a>
          <a href="https://github.com/aashish254/limen" class="btn-secondary">View on GitHub</a>
        </div>
      </div>
      
      <!-- Terminal Demo -->
      <div class="demo-terminal">
        <div class="terminal-header">
          <div class="terminal-dots">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
          </div>
          <div class="terminal-title">bash — limen demo</div>
        </div>
        <div class="terminal-body">
          <span class="code-sample">
            <span class="code-line"><span class="term-comment"># Agent request arrives</span></span>
            <span class="code-line">$ claude-code "fix the login bug"</span>
            <span class="code-line"><span class="term-arrow">→</span> Analyzing with Laya...</span>
            <span class="code-line"><span class="term-comment"># Decision: drop unused context chunks</span></span>
            <span class="code-line"><span class="term-purple">LAYER</span>: <span class="term-blue">observation</span> - user message is clear</span>
            <span class="code-line"><span class="term-purple">LAYER</span>: <span class="term-blue">context_prune</span> - removing {{HEAD_PCT}}% waste</span>
            <span class="code-line"><span class="term-purple">LAYER</span>: <span class="term-green">effort_tier</span>: <span class="term-orange">simple</span></span>
            <span class="code-line"><span class="term-comment"># Prompt sent to model</span></span>
            <span class="code-line"><span class="term-glow">✓ Optimized & ready</span></span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Bar -->
<section class="stats-bar">
  <div class="wrap">
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-label">Token Reduction</span>
        <span class="stat-value highlight">{{HEAD_PCT}}%</span>
        <span class="stat-unit">measured</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Pass Rate</span>
        <span class="stat-value highlight">≈100%</span>
        <span class="stat-unit">held constant</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">API Spend</span>
        <span class="stat-value highlight">$0</span>
        <span class="stat-unit">local only</span>
      </div>
      <div class="stat-item">
        <span class="stat-label">Decision Speed</span>
        <span class="stat-value"><300</span>
        <span class="stat-unit">ms per turn</span>
      </div>
    </div>
  </div>
</section>

<!-- Features Grid -->
<section id="features" class="features">
  <div class="wrap">
    <div class="section-title">
      <h2>Everything your agent needs,<br>nothing it wastes</h2>
      <p>A transparent proxy that optimizes every token before it's spent</p>
    </div>
    <div class="feature-grid">
      <!-- Feature 1 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M2 12h20"/>
          </svg>
        </div>
        <h3>Multi-dialect Proxy</h3>
        <p>Works with any terminal coding agent. OpenAI, Anthropic, Gemini compatible.</p>
      </div>
      <!-- Feature 2 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <h3>Local Decisions</h3>
        <p>Runs entirely on-device with swappable decision models like Laya or OpenJev.</p>
      </div>
      <!-- Feature 3 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20V10M18 20V4M6 20v-6"/>
          </svg>
        </div>
        <h3>Token Pruning</h3>
        <p>Drops irrelevant context chunks, tool schemas, and repetitive logs automatically.</p>
      </div>
      <!-- Feature 4 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="16" rx="2"/>
            <path d="M7 8h2M17 8h2M7 12h2M17 12h2M7 16h2"/>
          </svg>
        </div>
        <h3>Telemetry + Dataset</h3>
        <p>Built-in metrics collection creates a fine-tuning dataset just by using it.</p>
      </div>
      <!-- Feature 5 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3>Zero Trust Floor</h3>
        <p>The last N turns are always untouched. Every drop is logged and reversible.</p>
      </div>
      <!-- Feature 6 -->
      <div class="feature-card">
        <div class="feature-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
        </div>
        <h3>Swappable Models</h3>
        <p>Start with built-in heuristics or load trained System One models anytime.</p>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section id="how-it-works" class="how-it-works">
  <div class="wrap">
    <div class="section-title">
      <h2>How Limen works</h2>
      <p>Four simple layers that decide before you pay</p>
    </div>
    <div class="steps">
      <div class="step-card">
        <div class="step-number" data-step="1">01</div>
        <h3>Observation</h3>
        <p>Your coding agent sends a request to the model via Limen as if it were the direct endpoint.</p>
      </div>
      <div class="step-card">
        <div class="step-number" data-step="2">02</div>
        <h3>Analysis</h3>
        <p>Laya (or your chosen model) inspects the prompt and classifies context relevance in parallel.</p>
      </div>
      <div class="step-card">
        <div class="step-number" data-step="3">03</div>
        <h3>Pruning</h3>
        <p>Low-signal chunks, redundant tool definitions, and stale logs get dropped from the payload.</p>
      </div>
      <div class="step-card">
        <div class="step-number" data-step="4">04</div>
        <h3>Delivery</h3>
        <p>The optimized prompt reaches the model. Your agent sees nothing changed. You save money.</p>
      </div>
    </div>
  </div>
</section>

<!-- Terminal Examples -->
<section id="terminal" class="terminal-section">
  <div class="wrap">
    <div class="section-title">
      <h2>Tiny changes. Huge impact.</h2>
      <p>Real terminal output from a live coding session with Limen</p>
    </div>
    <div class="terminals-container">
      <div class="terminal-example">
        <div class="terminal-header">
          <div class="terminal-dots">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
          </div>
          <div class="terminal-title">limen-agent-session.log</div>
        </div>
        <div class="code-sample">
          <span class="code-line"><span class="term-comment"># Without Limen</span></span>
          <span class="code-line"><span class="term-purple">RAW PROMPT:</span> 47,000 tokens → $0.23</span>
          <span class="code-line"><span class="term-comment"># Context includes:</span></span>
          <span class="code-line"><span class="term-muted">• Full file contents</span></span>
          <span class="code-line"><span class="term-muted">• All 200+ lines of logs</span></span>
          <span class="code-line"><span class="term-muted">• Complete tool schemas</span></span>
          <span class="code-line"><span class="term-muted">• Previous 50 messages</span></span>
        </div>
      </div>
      <div class="terminal-example">
        <div class="terminal-header">
          <div class="terminal-dots">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
          </div>
          <div class="terminal-title">limen-agent-session.log</div>
        </div>
        <div class="code-sample">
          <span class="code-line"><span class="term-comment"># With Limen</span></span>
          <span class="code-line"><span class="term-green">OPTIMIZED:</span> 26,500 tokens → $0.13</span>
          <span class="code-line"><span class="term-purple">DROPPED:</span></span>
          <span class="code-line"><span class="term-arrow">→</span> 12,000 tokens from logs</span>
          <span class="code-line"><span class="term-arrow">→</span> 6,500 tokens from tool schemas</span>
          <span class="code-line"><span class="term-green">SAVED:</span> 43.6% fewer tokens</span>
        </div>
